<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SOC 2 Evidence Report - {{ s.account_id }}</title>
<style>
:root{--bg:#f8fafc;--card:#fff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;
--pass:#047857;--pass-bg:#d1fae5;--fail:#b91c1c;--fail-bg:#fee2e2;--err:#92400e;--err-bg:#fef3c7;--na:#475569;--na-bg:#f1f5f9}
@media (prefers-color-scheme:dark){:root{--bg:#0b1120;--card:#111827;--ink:#e5e7eb;--muted:#94a3b8;--line:#1f2937;
--pass:#6ee7b7;--pass-bg:#064e3b;--fail:#fca5a5;--fail-bg:#7f1d1d;--err:#fcd34d;--err-bg:#78350f;--na:#cbd5e1;--na-bg:#1e293b}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
main{max-width:1100px;margin:0 auto;padding:32px 16px}
h1{font-size:24px;margin:0 0 4px}h2{font-size:17px;margin:32px 0 12px}
.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-top:20px}
.stat b{display:block;font-size:26px}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.pill{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap}
.PASS{color:var(--pass);background:var(--pass-bg)}.FAIL{color:var(--fail);background:var(--fail-bg)}
.ERROR{color:var(--err);background:var(--err-bg)}.NA{color:var(--na);background:var(--na-bg)}
details summary{cursor:pointer;color:var(--muted)}ul{margin:6px 0;padding-left:18px}code{font-size:12px;word-break:break-all}
.note{font-size:13px;color:var(--muted);margin-top:24px}
.scroll{overflow-x:auto}
@media print{details{display:block}details>*{display:block}}
</style>
</head>
<body><main>
<h1>SOC 2 Evidence Report</h1>
<div class="muted">AWS account {{ s.account_id }} &middot; scanned {{ s.finished_at }} &middot; {{ s.regions|length }} region(s)</div>

<div class="grid">
  <div class="card stat"><span class="muted">Automated score</span><b>{{ s.score }}%</b></div>
  <div class="card stat"><span class="muted">Passing</span><b>{{ s.counts.PASS }}</b></div>
  <div class="card stat"><span class="muted">Failing</span><b>{{ s.counts.FAIL }}</b></div>
  <div class="card stat"><span class="muted">Could not evaluate</span><b>{{ s.counts.ERROR }}</b></div>
  <div class="card stat"><span class="muted">Not applicable</span><b>{{ s.counts['N/A'] }}</b></div>
</div>

<h2>Automated checks</h2>
<div class="scroll"><table>
<thead><tr><th>Status</th><th>Check</th><th>Criteria</th><th>Severity</th><th>Region</th><th>Result</th></tr></thead>
<tbody>
{% for r in s.results %}
<tr>
<td><span class="pill {{ 'NA' if r.status == 'N/A' else r.status }}">{{ r.status }}</span></td>
<td><b>{{ r.check_id }}</b> {{ r.title }}
{% if r.status in ('FAIL','ERROR') %}
<details><summary>Details &amp; fix</summary>
{% if r.error %}<div><code>{{ r.error }}</code></div>{% endif %}
<ul>{% for f in r.findings if f.status == 'FAIL' %}<li><code>{{ f.resource }}</code> - {{ f.detail }}</li>{% endfor %}</ul>
<div><b>Fix:</b> {{ r.remediation }}</div>
<div class="muted">Evidence: <code>{{ r.evidence_file }}</code></div>
</details>
{% endif %}
</td>
<td>{{ r.criteria|join(', ') }}</td><td>{{ r.severity }}</td><td>{{ r.region }}</td><td>{{ r.summary }}</td>
</tr>
{% endfor %}
</tbody></table></div>

<h2>Trust Services Criteria coverage</h2>
<div class="scroll"><table>
<thead><tr><th>Criterion</th><th>Description</th><th>Automated</th><th>Manual controls</th><th>Pass / Fail</th></tr></thead>
<tbody>
{% for c in s.criteria %}
<tr><td><b>{{ c.criterion }}</b></td><td>{{ c.name }}</td><td>{{ c.automated_checks|join(', ') or '-' }}</td>
<td>{{ c.manual_controls|join(', ') or '-' }}</td><td>{{ c.pass }} / {{ c.fail }}</td></tr>
{% endfor %}
</tbody></table></div>

<h2>Manual controls to evidence</h2>
<div class="scroll"><table>
<thead><tr><th>ID</th><th>Criterion</th><th>Control</th><th>Evidence to collect</th><th>Frequency</th></tr></thead>
<tbody>
{% for m in s.manual_controls %}
<tr><td>{{ m.id }}</td><td>{{ m.criterion }}</td><td>{{ m.control }}</td><td>{{ m.evidence }}</td><td>{{ m.frequency }}</td></tr>
{% endfor %}
</tbody></table></div>

<p class="note">{{ s.disclaimer }} Raw API responses for every check are in the <code>evidence/</code> folder;
<code>manifest.json</code> lists a SHA-256 hash for each file. Generated by {{ s.tool.name }} {{ s.tool.version }}
as <code>{{ s.principal_arn }}</code>.</p>
</main></body></html>
